# ============================================================================
# GoaCore — configuration d'installation. Copiez ce fichier en « .env » à côté
# du docker-compose.yml, puis renseignez au minimum les valeurs REQUISES.
#   cp .env.example .env
# ============================================================================

# --- Version de l'image à déployer (latest = dernière publiée) ---
# En production, épinglez une version (ex. v1.4.0) : une mise à jour doit être une
# décision, pas un effet de bord du prochain `docker compose pull`.
GOACORE_TAG=latest

# --- Sauvegarde ---
# La base contient tout l'état de GoaCore et ses secrets chiffrés. Mettez en place
# la sauvegarde le jour de l'installation :
#   ./backup.sh dump      (voir install/backup.sh, cron conseillé à 3 h)
# Rétention et destination du script :
# GOACORE_BACKUP_DIR=./backups
# GOACORE_BACKUP_RETENTION_DAYS=14

# ============================================================================
# REQUIS
# ============================================================================

# Base de données MySQL (créée automatiquement par le conteneur db).
DB_NAME=goacore
DB_USER=goacore
DB_PASSWORD=change-me-mot-de-passe-fort
DB_ROOT_PASSWORD=change-me-root-mot-de-passe-fort

# Clé de signature des sessions — OBLIGATOIRE, 32+ octets aléatoires.
# Générez-la avec :  openssl rand -hex 32
# À SAUVEGARDER avec la base : elle chiffre les secrets stockés (token Proxmox,
# clés SSH). Un dump restauré avec une autre valeur les rend illisibles.
SESSION_SECRET=change-me-openssl-rand-hex-32

# Cookies sécurisés (HTTPS). Laissez true en production.
COOKIE_SECURE=true

# Reverse proxy de confiance (CIDR séparés par des virgules). Laisser VIDE si
# GoaCore est joint directement : X-Forwarded-For n'est alors pas cru, ce qui
# empêche un attaquant de forger son IP pour contourner le blocage anti-force
# brute. À renseigner uniquement derrière un proxy, avec SON adresse et rien de
# plus large — sinon n'importe qui peut de nouveau forger l'en-tête.
TRUSTED_PROXIES=
# Mettre true UNIQUEMENT si vos services internes ont des certificats auto-signés.
SKIP_TLS_VERIFY=false

# ============================================================================
# TLS de l'interface
# ============================================================================
# Noms DNS et IP couverts par le certificat auto-signé (séparés par des virgules).
# À RENSEIGNER : sans eux le certificat ne vaut que pour localhost/127.0.0.1, et
# le navigateur affiche une erreur à chaque accès. Mettez le nom (et/ou l'IP) par
# lequel vous ouvrez GoaCore.
#   TLS_HOSTS=core.example.com,192.168.20.11
TLS_HOSTS=

# Le certificat est persisté dans le volume goacore_tls : il n'est régénéré que
# s'il est absent, expiré ou s'il ne couvre plus TLS_HOSTS. Son empreinte ne
# change donc plus à chaque mise à jour.

# Pour fournir VOTRE certificat (Let's Encrypt, PKI interne), renseignez les deux
# variables et décommentez le montage « ./tls:/run/tls:ro » du docker-compose.yml.
# GoaCore ne les écrase jamais et refuse de démarrer s'ils sont illisibles.
# TLS_CERT_FILE=/run/tls/fullchain.pem
# TLS_KEY_FILE=/run/tls/privkey.pem

# ============================================================================
# Secrets par fichier (convention Docker « _FILE ») — recommandé
# ============================================================================
# Chaque secret accepte une variante <NOM>_FILE pointant vers un fichier : GoaCore
# lit le contenu du fichier (retour à la ligne final ignoré) au lieu de la
# variable d'environnement, que `docker inspect` et /proc/<pid>/environ exposent à
# quiconque atteint le démon Docker. Le _FILE l'emporte sur la variable simple, et
# un fichier absent ou vide REFUSE le démarrage.
#
# Mise en place : décommentez « ./secrets:/run/secrets:ro » dans docker-compose.yml
#   mkdir -p secrets && openssl rand -hex 32 > secrets/session_secret
#   chmod 600 secrets/*
#
# SESSION_SECRET_FILE=/run/secrets/session_secret
# DB_PASSWORD_FILE=/run/secrets/db_password
# PROXMOX_TOKEN_SECRET_FILE=
# WAZUH_PASSWORD_FILE=
# WAZUH_INDEXER_PASSWORD_FILE=
# AI_API_KEY_FILE=
# DISCORD_BOT_TOKEN_FILE=
# Conteneur MySQL : EXCLUSIF de DB_ROOT_PASSWORD (laissez l'autre vide).
# DB_ROOT_PASSWORD_FILE=/run/secrets/db_root_password

# ============================================================================
# OPTIONNEL — tout ceci se configure aussi depuis l'interface (menu « Connexions »).
# Laissez vide pour commencer ; GoaCore vous guidera.
# ============================================================================

# --- Proxmox VE ---
PROXMOX_URL=
PROXMOX_NODE=pve
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
PROXMOX_STORAGE=
PROXMOX_BRIDGE=

# --- Wazuh (SIEM) ---
WAZUH_API_URL=
WAZUH_USER=
WAZUH_PASSWORD=
WAZUH_INDEXER_URL=
WAZUH_INDEXER_USER=
WAZUH_INDEXER_PASSWORD=

# --- Discord (notifications) ---
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_AUTH_CHANNEL_ID=
DISCORD_ANSIBLE_CHANNEL_ID=

# --- IA / enrichissement SOAR ---
AI_PROVIDER=
AI_URL=
AI_API_KEY=
AI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
